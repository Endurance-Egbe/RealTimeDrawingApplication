# Deployment example only.
# The application reads this value from the process/user/machine environment.
# It does not automatically load a .env file.
#
# PowerShell:
#   $env:REALTIME_DRAWING_POSTGRES_CONNECTION_STRING = "Host=localhost;Port=5432;Database=drawing;Username=app;Password=change-me;Timeout=3"
#
# Windows permanent user variable:
#   [Environment]::SetEnvironmentVariable("REALTIME_DRAWING_POSTGRES_CONNECTION_STRING", "Host=localhost;Port=5432;Database=drawing;Username=app;Password=change-me;Timeout=3", "User")

REALTIME_DRAWING_POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=drawing;Username=app;Password=change-me;Timeout=3
